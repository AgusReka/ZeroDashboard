generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Domain data model — CH-02. See openspec/changes/CH-02-initial-data-model/design.md
// for the rationale behind field choices (Spanish naming, tenantId scoping,
// no encryption/no motor enum yet — both depend on later work: A2 and D-4).

model Tenant {
  id                 String             @id @default(uuid())
  nombre             String
  creadoEn           DateTime           @default(now())
  conexiones         Conexion[]
  consultasGuardadas ConsultaGuardada[]
}

model Conexion {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  nombre        String
  motor         String
  host          String
  puerto        Int
  baseDeDatos   String
  usuarioDb     String
  credencial    String
  soloLectura   Boolean  @default(true)
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([tenantId])
}

model ConsultaGuardada {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  nombre        String
  descripcion   String?
  sql           String
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([tenantId])
}
