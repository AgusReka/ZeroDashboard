generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Domain data model — CH-02. See openspec/changes/CH-02-initial-data-model/design.md
// for the rationale behind field choices (Spanish naming, tenantId scoping,
// no encryption/no motor enum yet — both depend on later work: A2 and D-4).

// `activo` is CH-06's only schema change (DEC-14): deactivation is a state
// transition that keeps the row, so there is no delete and no reactivation path.
// The `true` default is what makes the migration additive — every pre-CH-06 row
// backfills as active and every pre-CH-06 code path stays valid on rollback.
model Tenant {
  id                 String             @id @default(uuid())
  nombre             String
  activo             Boolean            @default(true)
  creadoEn           DateTime           @default(now())
  conexiones         Conexion[]
  consultasGuardadas ConsultaGuardada[]
  vistasCanonicas    VistaCanonica[]
  automatizaciones   Automatizacion[]
  ejecuciones        Ejecucion[]
}

model Conexion {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  nombre           String
  motor            String
  host             String
  puerto           Int
  baseDeDatos      String
  usuarioDb        String
  credencial       String
  soloLectura      Boolean          @default(true)
  creadaEn         DateTime         @default(now())
  actualizadaEn    DateTime         @updatedAt
  vistasCanonicas  VistaCanonica[]
  automatizaciones Automatizacion[]

  @@index([tenantId])
}

// CH-11 (DEC-48, DEC-55): `parametros` is the query's parameter declaration, a JSON list
// of `{nombre, tipo}` read and written whole with the row. Its content is validated in
// the application (`src/parametros.ts`), not by the database. The `[]` default is what
// makes the migration additive: every pre-CH-11 row backfills as declaring nothing.
model ConsultaGuardada {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  nombre        String
  descripcion   String?
  sql           String
  parametros    Json     @default("[]")
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@index([tenantId])
}

// CH-09 (DEC-30 to DEC-34): one operator-authored canonical view definition per
// `Conexion` x canonical entity (DEC-32, DEC-33). The `sql` text is stored verbatim;
// prepending it as a `WITH` is CH-12's job (DEC-31), so nothing here parses, composes
// or executes it.
//
// `entidad` is plain TEXT validated in the application against `CONTRATO_CANONICO`:
// the contract lives in code (DEC-21), so a DB enum or CHECK would duplicate it and
// force a migration per contract edit. The unique pair is what makes re-registration
// an in-place replace (DEC-34). `tenantId` is a direct column so the isolation
// extension can scope this model like `Conexion` and `ConsultaGuardada` (DEC-13,
// DEC-33); the cross-tenant `conexionId` case is closed by a scoped lookup in the
// route, not by a composite FK (DEC-35).
//
// CH-10 (DEC-40, DEC-41, DEC-44): the latest structural validation result lives on the
// row itself, never in a history model. `estadoValidacion` is plain TEXT for the same
// reason `entidad` is ('no-validado' | 'valida' | 'invalida', checked in
// `src/validacion-mapeo.ts`). Its default is what makes the migration additive: every
// pre-CH-10 row backfills as never validated. Re-registering the SQL resets all three.
model VistaCanonica {
  id                    String    @id @default(uuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  conexionId            String
  conexion              Conexion  @relation(fields: [conexionId], references: [id])
  entidad               String
  sql                   String
  creadaEn              DateTime  @default(now())
  actualizadaEn         DateTime  @updatedAt
  estadoValidacion      String    @default("no-validado")
  diagnosticoValidacion Json?
  validadaEn            DateTime?

  @@unique([conexionId, entidad])
  @@index([tenantId])
}

// CH-12 (DEC-61): an automation template is a GLOBAL catalog entry, not tenant data.
// It has no `tenantId` column and no relation to `Tenant`, and it is deliberately
// absent from `MODELOS_AISLADOS` in `src/aislamiento-prisma.ts`, so the isolation
// extension passes it through exactly as it passes `Tenant` through. A template becomes
// tenant-bound only when a tenant instantiates it as an automation, which is CH-21's
// job, not this model's.
//
// `parametros` (the CH-11 declaration shape) and `entidades` (the canonical entities the
// template composes, DEC-63) are JSON columns validated in the application, the same
// choice as `ConsultaGuardada.parametros` (DEC-73). `automatizacion` and `formato` are
// plain TEXT for the reason `VistaCanonica.entidad` is: their allowed values live in
// code (`AUTOMATIZACIONES`, DEC-67; `correo-html`, DEC-65), so a DB enum would be a
// second source of truth. `toleranciaFrescuraMinutos` is stored and not yet enforced
// (DEC-66). A template is replaced in place by id and never deleted (DEC-68).
model Plantilla {
  id                        String           @id @default(uuid())
  nombre                    String
  sql                       String
  parametros                Json             @default("[]")
  entidades                 Json
  automatizacion            String
  formato                   String
  toleranciaFrescuraMinutos Int
  automatizaciones          Automatizacion[]
}

// CH-13 (DEC-74): an automation is a tenant's instance of a global `Plantilla`, bound to
// one of that tenant's own `Conexion` rows, a set of parameter values and a standard
// 5-field cron schedule. `tenantId` is a direct column so the isolation extension scopes
// it like every other tenant model (DEC-13); the cross-tenant `conexionId` case is closed
// by a scoped lookup in the route, not by a composite FK (DEC-35 precedent).
//
// `valores` is a JSON object validated in the application against the template's CH-11
// declaration, at creation and again on every run, because DEC-68 replaces a template in
// place and stored values can go stale. `cron` is plain TEXT validated in the application
// (DEC-76). `activo` has the same meaning as `Tenant.activo`: deactivation keeps the row,
// and there is no edit, delete or reactivation path (DEC-79). Every foreign key is
// RESTRICT, so nothing an automation references can be deleted out from under it.
//
// CH-14 (DEC-82): `destinatario` is the one email address a run's rows are sent to. It
// is nullable so pre-CH-14 automations keep running (they record `sin-destinatario`),
// is validated in the application at creation, and there is no global fallback.
model Automatizacion {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  plantillaId  String
  plantilla    Plantilla   @relation(fields: [plantillaId], references: [id])
  conexionId   String
  conexion     Conexion    @relation(fields: [conexionId], references: [id])
  valores      Json        @default("{}")
  cron         String
  activo       Boolean     @default(true)
  creadaEn     DateTime    @default(now())
  destinatario String?
  ejecuciones  Ejecucion[]

  @@index([tenantId])
}

// CH-13 (X2): one row per run of an `Automatizacion`, metadata only. The run's result
// rows are counted and discarded; nothing here holds tenant data read from the tenant's
// database (regla 5). `estado` ('en-curso' | 'ok' | 'fallo'), `corte` and `fase`
// ('preparacion' or an execution phase) are plain TEXT for the reason `entidad` is:
// their allowed values live in code. `error` is a closed category and `codigoError` a
// publishable SQLSTATE; a raw driver message or stack trace is never stored.
//
// `iniciadaEn` and `finalizadaEn` carry no database default: the scheduler writes them
// from its injected clock, so tests control time. The closing columns are nullable
// because a row is written `en-curso` before the run and closed after it.
//
// CH-14 (DEC-83): `notificacion` is the run's notification outcome, plain TEXT whose
// allowed values live in code ('enviada' | 'omitida-sin-filas' | 'fallo-envio' |
// 'sin-destinatario' | 'no-configurada'). It is null when the query failed and for rows
// written before CH-14. It holds the outcome only, never a body, recipient or row.
model Ejecucion {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  automatizacionId String
  automatizacion   Automatizacion @relation(fields: [automatizacionId], references: [id])
  estado           String
  iniciadaEn       DateTime
  finalizadaEn     DateTime?
  duracionMs       Int?
  filas            Int?
  corte            String?
  fase             String?
  error            String?
  codigoError      String?
  notificacion     String?

  @@index([tenantId])
  @@index([automatizacionId, iniciadaEn])
}
