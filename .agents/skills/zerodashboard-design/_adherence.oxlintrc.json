{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/automation/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/tenant/**",
              "ui_kits/**",
              "ui_kits/consola/**",
              "ui_kits/panel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AutomationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|descripcion|estado|estadoLabel|ultima|proxima|frecuencia|children|alert|disponible|key|ref|className|style|children)$/]",
        "message": "<AutomationCard> doesn't accept that prop. Declared props: titulo, descripcion, estado, estadoLabel, ultima, proxima, frecuencia, children, alert, disponible."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|actions|icon|inline|onDismiss|role|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, title, children, actions, icon, inline, onDismiss, role."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|ok|warn|error|neutral)$/]",
        "message": "<Banner> tone must be one of 'info' | 'ok' | 'warn' | 'error' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:alert|status)$/]",
        "message": "<Banner> role must be one of 'alert' | 'status'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|iconOnly|label|block|loading|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, iconOnly, label, block, loading, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectivityIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:estado|ultimoLatido|label|onDark|key|ref|className|style|children)$/]",
        "message": "<ConnectivityIndicator> doesn't accept that prop. Declared props: estado, ultimoLatido, label, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectivityIndicator'] > JSXAttribute[name.name='estado'] > Literal[value!=/^(?:conectado|desconectado|sin_datos)$/]",
        "message": "<ConnectivityIndicator> estado must be one of 'conectado' | 'desconectado' | 'sin_datos'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|render|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, width, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:num|mono)$/]",
        "message": "<DataTableColumn> align must be one of 'num' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|onClose|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|eyebrow|title|children|footer|onClose|wide|key|ref|className|style|children)$/]",
        "message": "<Drawer> doesn't accept that prop. Declared props: open, eyebrow, title, children, footer, onClose, wide."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|children|actions|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, children, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|detail|actions|icon|key|ref|className|style|children)$/]",
        "message": "<ErrorState> doesn't accept that prop. Declared props: title, children, detail, actions, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|as|help|error|optional|suffix|mono|children|value|defaultValue|onChange|type|placeholder|rows|disabled|required|min|max|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, id, as, help, error, optional, suffix, mono, children, value, defaultValue, onChange, type, placeholder, rows, disabled, required, min, max, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|select|textarea)$/]",
        "message": "<Field> as must be one of 'input' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|spin|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, spin, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyValueList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|layout|key|ref|className|style|children)$/]",
        "message": "<KeyValueList> doesn't accept that prop. Declared props: items, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyValueList'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:rows|grid|stack)$/]",
        "message": "<KeyValueList> layout must be one of 'rows' | 'grid' | 'stack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|rows|key|ref|className|style|children)$/]",
        "message": "<LoadingState> doesn't accept that prop. Declared props: label, variant, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:spinner|skeleton)$/]",
        "message": "<LoadingState> variant must be one of 'spinner' | 'skeleton'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|scope|tenantName|crumbs|change|estado|actions|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, description, scope, tenantName, crumbs, change, estado, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute[name.name='scope'] > Literal[value!=/^(?:global|tenant)$/]",
        "message": "<PageHeader> scope must be one of 'global' | 'tenant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScopeTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:scope|tenantName|key|ref|className|style|children)$/]",
        "message": "<ScopeTag> doesn't accept that prop. Declared props: scope, tenantName."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScopeTag'] > JSXAttribute[name.name='scope'] > Literal[value!=/^(?:global|tenant)$/]",
        "message": "<ScopeTag> scope must be one of 'global' | 'tenant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|href|meta|key|ref|className|style|children)$/]",
        "message": "<SideNavItem> doesn't accept that prop. Declared props: id, label, icon, href, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:estado|tone|icon|label|square|attempt|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: estado, tone, icon, label, square, attempt."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|error|info|neutral|tenant)$/]",
        "message": "<StatusBadge> tone must be one of 'ok' | 'warn' | 'error' | 'info' | 'neutral' | 'tenant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|label|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: steps, current, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TemplateOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|nombre|descripcion|icon|meta|key|ref|className|style|children)$/]",
        "message": "<TemplateOption> doesn't accept that prop. Declared props: id, nombre, descripcion, icon, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='TenantBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:tenant|onChange|children|key|ref|className|style|children)$/]",
        "message": "<TenantBar> doesn't accept that prop. Declared props: tenant, onChange, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
