# CH-19c2 (DEC-123): the agent's only three variables. Copy to .env.agente, fill in, and
# never commit it. The agent never prints a value: a bad one stops it with exit 1 and
# names only the variable. Every limit and timing is a constant, not a variable.

# The engine's origin only: wss://host[:port]. No userinfo, path, query or fragment.
# ws:// is accepted only for localhost, 127.x.x.x or [::1] (local tests).
AGENT_SERVER_URL=

# The zda_ token from POST /agentes. It is shown once and is a secret: keep it out of the
# repository, logs and screenshots. A rejected or revoked token stops the agent (exit 2).
AGENT_TOKEN=

# Comma-separated exact host:port entries the engine may open sessions to. DNS name, IPv4
# or [IPv6]; port from 1 to 65535. No wildcards, CIDR or ranges. Examples:
#   replica.internal:5432
#   10.0.0.5:5432,[fd00::5]:5432
AGENT_ALLOWED_TARGETS=
