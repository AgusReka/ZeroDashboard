POSTGRES_USER=zerodashboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zerodashboard

# Compose service name "db" as host — matches docker-compose.yml
DATABASE_URL=postgresql://zerodashboard:change-me@db:5432/zerodashboard

APP_PORT=3000
NODE_ENV=development

# Required. Master key for credential encryption at rest (A2, DEC-16/DEC-17): one key
# per deployment, base64 of exactly 32 random bytes (AES-256). The application refuses
# to start when it is absent, malformed or the wrong length.
#
# Generate one per deployment and keep it OUT of the repository and out of the
# application's own database — a dump of that database is precisely what this key is
# supposed to be useless without:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# The placeholder below is not a key: it is the wrong length on purpose, so a copied
# .env fails at boot instead of quietly enciphering under a value committed to git.
CREDENTIAL_MASTER_KEY=generar-con-el-comando-de-arriba

# Optional. Maximum duration of a single connection test attempt, in milliseconds.
# Positive integer. Defaults to 5000 when unset.
CONNECTION_TEST_TIMEOUT_MS=5000

# Optional. Maximum runtime of a single query execution, in milliseconds. Distinct
# from the connection-attempt budget above. Positive integer. Defaults to 15000
# when unset.
QUERY_TIMEOUT_MS=15000

# Optional. Ceiling on how many rows one execution may return, applied uniformly to
# every connection and every tenant (DEC-19). Positive integer. Defaults to 200 when
# unset, which is the value CH-04 hard-coded in the request schema. An execution the
# ceiling actually cut reports corte: "tope-de-filas", which is a different statement
# from hayMas: the cap says no further page will be served.
MAX_FILAS_CONSULTA=200

# Optional. The single, deployment-wide IANA timezone in which every automation's cron
# schedule is interpreted (DEC-77), e.g. America/Argentina/Buenos_Aires. There is no
# per-tenant or per-automation timezone. Defaults to UTC when unset; a value that is not
# a valid IANA timezone stops the application at boot.
ZONA_HORARIA_AUTOMATIZACIONES=UTC

# Optional (CH-14, DEC-81/DEC-86). SMTP server used to email each automation's rows to its
# recipient. Leave SMTP_HOST empty and email is simply not configured: the application
# starts normally and every run records notificacion='no-configurada'. Once SMTP_HOST is
# set, the rest has to be valid or the application refuses to start, naming the variable
# (never its value):
#   SMTP_PORT      positive integer; defaults to 465 when SMTP_SECURE=true, else 587
#   SMTP_SECURE    true or false; defaults to false
#   SMTP_USER      set together with SMTP_PASSWORD, or leave both empty (e.g. Mailpit)
#   SMTP_PASSWORD  never commit a real one; keep it in your local .env only
#   SMTP_FROM      required sender address, e.g. notificaciones@example.com
#
# For local development, `docker compose --profile correo up` also starts Mailpit; point
# the app at it with SMTP_HOST=mailpit, SMTP_PORT=1025 and a SMTP_FROM of your choice.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Maximum duration of one email send, in milliseconds (R2 under DEC-19): a hung
# SMTP server cannot hold the scheduler longer than this. Positive integer. Defaults to
# 10000 when unset.
SMTP_TIMEOUT_MS=

# Optional (CH-17b, DEC-97/DEC-98/DEC-105). Bounded retry of a scheduled run whose
# connection fails transiently (unreachable host, unresolved name, connection timeout).
# No other failure is retried, and an email send is never retried.
#   CONNECTION_RETRY_ATTEMPTS  total attempts per run, integer from 1 to 5; 1 turns retry
#                              off. Defaults to 3 when unset.
#   CONNECTION_RETRY_PAUSE_MS  fixed pause between attempts, in milliseconds. Positive
#                              integer. Defaults to 5000 when unset.
# A value outside those ranges stops the application at boot, naming the variable.
CONNECTION_RETRY_ATTEMPTS=
CONNECTION_RETRY_PAUSE_MS=

# Optional. Host ports for the Mailpit service of the `correo` Compose profile (SMTP and
# web UI). They default to 1026 and 8026 so they do not collide with another Mailpit
# already listening on 1025/8025; the web UI is then at http://localhost:8026.
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=
